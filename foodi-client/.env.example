# Firebase - copy this file to .env and fill in your values from Firebase Console
# https://console.firebase.google.com/ → Project settings → General → Your apps

VITE_APIKEY=your-api-key-here
VITE_AUTHDOMAIN=your-project.firebaseapp.com
VITE_PROJECTID=your-project-id
VITE_STORAGEBUCKET=your-project.appspot.com
VITE_MESSAGINGSENDERID=123456789
VITE_APPID=1:123456789:web:abc123
