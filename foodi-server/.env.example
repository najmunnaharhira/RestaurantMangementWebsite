# Server port (default: 6001)
PORT=6001

# MongoDB: set either DB_URI (full connection string) or DB_USER + DB_PASSWORD
# DB_URI=mongodb+srv://user:password@cluster.mongodb.net/dbname?retryWrites=true&w=majority
DB_USER=
DB_PASSWORD=

# Required for JWT signing (use a long random string in production)
ACCESS_TOKEN_SECRET=your-secret-key-here
